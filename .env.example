# ==============================================================================
# AICTE APAAR Student Data Management & Verification Platform
# Environment Configuration Template (Placeholders Only - Never Commit Secrets)
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Cryptographic Tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-secure-random-32-byte-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# Database Configuration (MySQL 8.0+)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aicte_admin
MYSQL_PASSWORD=replace-with-strong-db-password
MYSQL_DB=aicte_trust_layer

# Official APAAR / DigiLocker Gateway Adapter
# External APAAR Gateway credentials (set APAAR_LIVE_MODE=true once official credentials approved)
APAAR_LIVE_MODE=false
APAAR_API_ENDPOINT=https://api.digitallocker.gov.in/apaar/v1/verify
APAAR_API_KEY=replace-with-official-approved-moe-api-key
APAAR_REQUEST_TIMEOUT_SECONDS=5

# Rate Limiting & Abuse Protections
VERIFIER_RATE_LIMIT_MAX_QUERIES=30
VERIFIER_RATE_LIMIT_WINDOW_SECONDS=600

# Cryptographic Audit Chain Settings
BLOCKCHAIN_CHAIN_NAME="Polygon Amoy Testnet (Simulated Hash Anchor)"
BLOCKCHAIN_CONTRACT_ADDRESS="0x742d35Cc6634C0532925a3b844Bc454e4438f44e"

